{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxagent.local/contracts/v1/portfolio-snapshot.schema.json",
  "title": "PortfolioSnapshot",
  "type": "object",
  "required": [
    "snapshot_id",
    "tenant_id",
    "subject_id",
    "as_of",
    "accounts",
    "lots",
    "coverage"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "account_id",
          "tax_unit_id",
          "registration"
        ]
      }
    },
    "lots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lot_id",
          "account_id",
          "security_id",
          "quantity",
          "basis"
        ],
        "properties": {
          "lot_id": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "security_id": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "acquisition_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "basis": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "description": "Decimal string; never a float."
              },
              {
                "type": "null"
              }
            ],
            "description": "null means unknown, never zero."
          },
          "basis_source": {
            "type": "string"
          },
          "covered": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "account_id",
          "start",
          "end"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
