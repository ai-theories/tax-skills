{
  "mcpServers": {
    "taxagent-federal": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_server.sh",
      "args": [
        "--server",
        "federal"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/src"
      }
    },
    "taxagent-estate": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_server.sh",
